## QUY TẮC CODING BẮT BUỘC

```python
# 1. LUÔN dùng model_client.py — không gọi Ollama trực tiếp trong agents
from model.model_client import ModelClient
client = ModelClient(agent_type="sql")  # sets temperature và max_tokens tự động

# 2. LUÔN strip markdown fence trước khi parse JSON
import re, json

def safe_parse_json(text: str) -> dict:
    """Strip ```json ... ``` fence và parse — dùng ở mọi LLM JSON output"""
    clean = re.sub(r"```(?:json|python|sql)?\s*|\s*```", "", text).strip()
    return json.loads(clean)

# 3. LUÔN return đầy đủ state — không partial update
def sql_agent_node(state: MultiAgentState) -> MultiAgentState:
    # ... xử lý ...
    new_outputs = {**state["agent_outputs"], "sql": result}
    new_completed = state["completed_agents"] + ["sql"]
    return {
        **state,
        "agent_outputs": new_outputs,
        "completed_agents": new_completed,
        "shared_dataframe": df_to_state(df),
        "sql_result": {"sql": sql_str, "row_count": len(df)},
        "current_agent": "sql",
    }

# 4. LUÔN dùng parameterized queries cho SQL
# WRONG:
cursor.execute(f"SELECT * FROM orders WHERE region = '{region}'")
# CORRECT:
cursor.execute("SELECT * FROM orders WHERE region = %s", (region,))

# 5. LUÔN restricted exec() cho Python Agent
exec(code, PYTHON_SAFE_NAMESPACE | {"df": input_df})

# 6. LUÔN log action trace để debug
import json, pathlib, time
def append_trace(state: MultiAgentState, agent: str, action: str,
                  observation: str, status: str) -> list:
    entry = {
        "agent": agent, "action": action,
        "observation": observation, "status": status,
        "timestamp": time.time()
    }
    pathlib.Path("logs/").mkdir(exist_ok=True)
    return state["action_trace"] + [entry]

# 7. DataFrame serialization — KHÔNG lưu DataFrame trực tiếp vào state
# WRONG: state["shared_dataframe"] = df
# CORRECT:
from graph.utils import df_to_state, df_from_state
state["shared_dataframe"] = df_to_state(df)
df = df_from_state(state["shared_dataframe"])
```

