## MULTI-AGENT STATE

```python
# graph/state.py
from typing import TypedDict, Any

class MultiAgentState(TypedDict):
    # ── Input ──────────────────────────────────────────────
    query: str                        # câu hỏi gốc của user
    info_box: dict                    # JSON schema từ Perception Layer

    # ── Supervisor ─────────────────────────────────────────
    execution_plan: list[dict]        # [{step, agent, task, depends_on, skill_type}]
    current_agent: str                # agent đang chạy ("sql" | "python" | "viz" | "insight" | "reflector")
    completed_agents: list[str]       # agents đã hoàn thành

    # ── Inter-agent Communication ──────────────────────────
    agent_outputs: dict               # {agent_name: {status, output, error}}
    shared_dataframe: dict | None     # DataFrame dạng JSON-serializable
                                      # {"records": [...], "columns": [...], "dtypes": {...}}
    shared_metadata: dict             # context pass giữa agents (row_count, schema hints, etc.)

    # ── Error Handling ─────────────────────────────────────
    error_count: int                  # tổng số lỗi (max 5 toàn pipeline)
    agent_error_counts: dict          # {agent_name: count} — max 3 per agent
    last_error: dict | None           # {agent, error_type, traceback, corrected_context}

    # ── Final Outputs ──────────────────────────────────────
    sql_result: dict | None           # {sql, dataframe_json, row_count}
    python_result: dict | None        # {code, dataframe_json, stats}
    chart_b64: str | None             # base64 PNG
    chart_metadata: dict | None       # {chart_type, x_col, y_col, title}
    insight: dict | None              # {finding, evidence, anomaly, action, confidence}

    # ── Trace ──────────────────────────────────────────────
    action_trace: list[dict]          # toàn bộ trace cho UI display
    status: str                       # "planning" | "running" | "success" | "failed"
```

### DataFrame Serialization — QUAN TRỌNG

LangGraph state phải JSON-serializable. **Không được lưu DataFrame object trực tiếp vào state.**

```python
# Helpers — graph/utils.py

def df_to_state(df: pd.DataFrame) -> dict:
    """Convert DataFrame → JSON-serializable dict cho state"""
    return {
        "records": df.to_dict("records"),
        "columns": df.columns.tolist(),
        "dtypes": df.dtypes.astype(str).to_dict(),
        "shape": list(df.shape)
    }

def df_from_state(data: dict) -> pd.DataFrame:
    """Restore DataFrame từ state"""
    df = pd.DataFrame(data["records"])
    for col, dtype in data["dtypes"].items():
        try:
            df[col] = df[col].astype(dtype)
        except Exception:
            pass
    return df
```

